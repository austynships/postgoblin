# ---- Core -------------------------------------------------------------
# Public base URL of this app. OAuth redirect URIs are built from it:
#   {APP_URL}/api/oauth/callback/{provider}
# Threads image posts need this to be reachable from the internet.
APP_URL=http://localhost:3000

# 32+ random chars. Encrypts stored social tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# ---- Storage ------------------------------------------------------------
# Neon Postgres connection string (schema: db/schema.sql)
DATABASE_URL=

# Vercel Blob token for image/video uploads (Vercel -> Storage -> Blob).
# Leave empty locally to store uploads in ./uploads instead.
BLOB_READ_WRITE_TOKEN=

# Secret for /api/cron/publish. Generate like ENCRYPTION_KEY.
CRON_SECRET=

# ---- AI agent (Claude) ------------------------------------------------
ANTHROPIC_API_KEY=
# Optional overrides
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=medium

# ---- Social platforms (OAuth apps you register yourself) --------------
# Bluesky, Mastodon, Discord and Telegram need no keys here.

# X / Twitter  (developer.x.com -> OAuth 2.0, type "Web App", confidential client)
X_CLIENT_ID=
X_CLIENT_SECRET=

# LinkedIn  (linkedin.com/developers -> products: "Sign In with LinkedIn using OpenID Connect" + "Share on LinkedIn")
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_VERSION=202605

# Threads  (developers.facebook.com -> Threads use case)
THREADS_APP_ID=
THREADS_APP_SECRET=

# Facebook Pages  (developers.facebook.com -> pages_manage_posts, pages_show_list)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_GRAPH_VERSION=v23.0
# Required for apps using "Facebook Login for Business" (Login for Business → Configurations)
FACEBOOK_CONFIG_ID=

# Instagram  (uses the Facebook app above: add the Instagram use case -> "API setup with Facebook login",
# then a Facebook Login for Business configuration with instagram_basic + instagram_content_publish)
INSTAGRAM_CONFIG_ID=

# YouTube  (Google Cloud -> enable YouTube Data API v3 -> OAuth client, type Web application)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# public | unlisted | private (unverified Google apps are forced to private)
YOUTUBE_PRIVACY=public

# TikTok  (developers.tiktok.com -> Login Kit + Content Posting API)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# PUBLIC_TO_EVERYONE | MUTUAL_FOLLOW_FRIENDS | FOLLOWER_OF_CREATOR | SELF_ONLY (unaudited apps: SELF_ONLY)
TIKTOK_PRIVACY=PUBLIC_TO_EVERYONE

# ---- Scheduler --------------------------------------------------------
# Local development only: seconds between scheduler ticks.
# On Vercel, call /api/cron/publish every minute instead (see README).
SCHEDULER_INTERVAL=20
